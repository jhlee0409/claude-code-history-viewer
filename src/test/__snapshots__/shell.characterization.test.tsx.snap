              style="--os-scroll-percent: 0; --os-viewport-percent: 0; --os-scroll-direction: 0;"
            >
              <div
                class="os-scrollbar-track"
              >
                <div
                  class="os-scrollbar-handle"
                />
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
    <footer
      class="h-7 px-4 hidden md:flex items-center justify-between bg-sidebar border-t border-border/50 text-caption text-muted-foreground"
    >
      <div
        class="flex items-center gap-3 font-mono tabular-nums"
      >
        <span>
          Web
        </span>
        <span
          class="text-border"
        >
          •
        </span>
        <span>
          Projects: 1
        </span>
        <span
          class="text-border"
        >
          •
        </span>
        <span>
          Sessions: 1
        </span>
      </div>
    </footer>
    <div
      aria-atomic="true"
      aria-live="polite"
      class="sr-only"
      role="status"
    />
    <div
      data-handlers="onOpenSidebar,onSwitchView"
      data-props="{"activeTab":"messages","hasProject":true}"
      data-stub="BottomTabBar"
    />
  </div>
</div>
`;
